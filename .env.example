# Postgres connection string (required)
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/url_shortener?sslmode=disable

# Address the server listens on (optional, default 127.0.0.1:8080)
ADDR=127.0.0.1:8080

# Public base URL used to build short links (optional, default http://<ADDR>)
BASE_URL=http://127.0.0.1:8080
